{
    "mcpServers": {
        "astro-docs": {
            "type": "http",
            "url": "https://mcp.docs.astro.build/mcp"
        },
        "playwright": {
            "command": "npx",
            "args": ["-y", "@playwright/mcp@0.0.80", "--browser=chrome", "--headless", "--isolated"]
        },
        "chrome-devtools": {
            "command": "npx",
            "args": ["-y", "chrome-devtools-mcp@1.8.0", "--headless", "--isolated"]
        },
        "codegraph": {
            "command": "npx",
            "args": ["-y", "@colbymchenry/codegraph@1.6.0", "serve", "--mcp"]
        },
        "terraform": {
            "command": "docker",
            "args": ["run", "-i", "--rm", "hashicorp/terraform-mcp-server:1.3.0", "--toolsets=registry"]
        },
        "github": {
            "command": "docker",
            "args": [
                "run",
                "-i",
                "--rm",
                "-e",
                "GITHUB_PERSONAL_ACCESS_TOKEN=${BROKEN_ROBOT_XYZ_GITHUB_PERSONAL_ACCESS_TOKEN}",
                "-e",
                "GITHUB_READ_ONLY=1",
                "-e",
                "GITHUB_TOOLSETS=context,repos,issues,pull_requests,actions",
                "ghcr.io/github/github-mcp-server:v1.11.0"
            ]
        }
    }
}
